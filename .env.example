# Required only for the optional LLM pipeline. The blackboard demo needs no key.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
PERCEPTION_BACKEND=offline_cv
LLM_TEMPERATURE=0.3
VISION_TEMPERATURE=0.3
VISION_MAX_TOKENS=2048
OUTPUT_DIR=outputs
SAVE_INTERMEDIATES=true
MAX_REFINEMENT_STEPS=3
